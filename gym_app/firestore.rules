rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userDocAfter(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return isAuth() && userDoc(request.auth.uid).data.get('role', '') == 'admin';
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isActiveOwner(uid) {
      return isOwner(uid) &&
        userDoc(uid).data.get('isActive', true) == true &&
        (
          !userDoc(uid).data.keys().hasAny(['contractEndsAt']) ||
          userDoc(uid).data.get('contractEndsAt', null) == null ||
          userDoc(uid).data.get('contractEndsAt', request.time) > request.time
        );
    }

    function validDirectParticipants(data) {
      return data.keys().hasAll(['participantIds']) &&
        data.participantIds is list &&
        data.participantIds.size() == 2 &&
        data.participantIds[0] is string &&
        data.participantIds[1] is string &&
        data.participantIds[0].size() > 0 &&
        data.participantIds[1].size() > 0 &&
        data.participantIds[0] != data.participantIds[1];
    }

    function validDirectRoomForCurrentUser(data) {
      return validDirectParticipants(data) &&
        (
          isAdmin() ||
          (
            isActiveOwner(request.auth.uid) &&
            userDoc(request.auth.uid).data.get('role', '') == 'aluno' &&
            userDoc(request.auth.uid).data.get('personalId', '') is string &&
            userDoc(request.auth.uid).data.get('personalId', '') != '' &&
            data.participantIds.hasAll([
              request.auth.uid,
              userDoc(request.auth.uid).data.get('personalId', '')
            ]) &&
            userDoc(userDoc(request.auth.uid).data.get('personalId', '')).data.get('role', '') == 'admin'
          )
        );
    }

    function directRoomIdMatchesParticipants(salaId, data) {
      return validDirectParticipants(data) && (
        salaId == 'chat_' + data.participantIds[0] + '_' + data.participantIds[1] ||
        salaId == 'chat_' + data.participantIds[1] + '_' + data.participantIds[0]
      );
    }

    function legacyDirectRoomForCurrentUser(salaId) {
      return isAuth() &&
        isActiveOwner(request.auth.uid) &&
        userDoc(request.auth.uid).data.get('role', '') == 'aluno' &&
        userDoc(request.auth.uid).data.get('personalId', '') is string &&
        userDoc(request.auth.uid).data.get('personalId', '') != '' &&
        (
          salaId == 'chat_' + request.auth.uid + '_' +
            userDoc(request.auth.uid).data.get('personalId', '') ||
          salaId == 'chat_' + userDoc(request.auth.uid).data.get('personalId', '') +
            '_' + request.auth.uid
        ) &&
        (
          !exists(/databases/$(database)/documents/chat/$(salaId)) ||
          !get(/databases/$(database)/documents/chat/$(salaId)).data.keys()
            .hasAny(['participantIds'])
        );
    }

    function directRoomMember(data) {
      return isAuth() && validDirectParticipants(data) &&
        (
          isAdmin() ||
          (
            isActiveOwner(request.auth.uid) &&
            request.auth.uid in data.participantIds &&
            userDoc(request.auth.uid).data.get('role', '') == 'aluno' &&
            userDoc(request.auth.uid).data.get('personalId', '') is string &&
            userDoc(request.auth.uid).data.get('personalId', '') != '' &&
            data.participantIds.hasAll([
              request.auth.uid,
              userDoc(request.auth.uid).data.get('personalId', '')
            ]) &&
            userDoc(userDoc(request.auth.uid).data.get('personalId', '')).data.get('role', '') == 'admin'
          )
        );
    }

    function directRoomMemberAfter(salaId) {
      return directRoomMember(
        getAfter(/databases/$(database)/documents/chat/$(salaId)).data
      );
    }

    function validMessage(data) {
      return data.keys().hasOnly([
          'remetenteId', 'texto', 'timestamp', 'lida',
          'audioUrl', 'audioDurationMs', 'attachmentUrl',
          'attachmentName', 'attachmentType'
        ]) &&
        data.get('remetenteId', '') is string &&
        data.get('remetenteId', '') == request.auth.uid &&
        data.get('texto', '') is string &&
        data.get('texto', '').size() <= 1000 &&
        data.get('timestamp', null) is timestamp &&
        data.get('lida', false) == false &&
        (
          !data.keys().hasAny(['audioUrl']) ||
          (data.get('audioUrl', '') is string && data.get('audioUrl', '').size() > 0)
        ) &&
        (
          !data.keys().hasAny(['attachmentUrl']) ||
          (data.get('attachmentUrl', '') is string && data.get('attachmentUrl', '').size() > 0)
        ) &&
        (
          !data.keys().hasAny(['audioDurationMs']) ||
          (data.get('audioDurationMs', 0) is int && data.get('audioDurationMs', 0) >= 0)
        );
    }

    function activeQuestionnaireVersion() {
      return exists(/databases/$(database)/documents/questionnaireConfig/active)
        ? get(/databases/$(database)/documents/questionnaireConfig/active).data.get('version', 'questionnaire-2026-08-health-v2')
        : 'questionnaire-2026-08-health-v2';
    }

    function validQuestionnaire(data) {
      return data.keys().hasOnly(['version', 'completedAt', 'answers']) &&
        data.get('version', '') == activeQuestionnaireVersion() &&
        data.get('completedAt', null) is timestamp &&
        data.get('completedAt', request.time) <= request.time &&
        data.get('answers', {}) is map &&
        data.answers.keys().hasAll([
          'birthDate', 'nome', 'genero', 'peso', 'altura',
          'profession', 'activity', 'sedentary', 'meals', 'water', 'sleep',
          'pathologiesHas', 'familyPathologiesHas', 'surgeryHas',
          'medicationHas', 'supplementsHas', 'allergiesHas',
          'dislikedFoods', 'preferredFoods', 'outsideMeals', 'objective'
        ]) &&
        data.answers.keys().size() <= 100;
    }

    function validQuestionnaireCompletion(uid) {
      return userDocAfter(uid).data.get('questionnaireVersion', '') ==
          activeQuestionnaireVersion() &&
        userDocAfter(uid).data.get('questionnaireCompletedAt', null) is timestamp &&
        userDocAfter(uid).data.get('questionnaireCompletedAt', request.time) <= request.time &&
        getAfter(/databases/$(database)/documents/users/$(uid)/questionario/resposta).data.version ==
          activeQuestionnaireVersion() &&
        validQuestionnaire(
          getAfter(/databases/$(database)/documents/users/$(uid)/questionario/resposta).data
        );
    }

    function validGroupMessage(data) {
      return data.keys().hasOnly([
          'remetenteId', 'texto', 'timestamp', 'lida',
          'audioUrl', 'audioDurationMs', 'attachmentUrl',
          'attachmentName', 'attachmentType'
        ]) &&
        data.get('remetenteId', '') is string &&
        data.get('remetenteId', '') == request.auth.uid &&
        data.get('texto', '') is string &&
        data.get('texto', '').size() <= 1000 &&
        data.get('timestamp', null) is timestamp &&
        data.get('lida', false) == false;
    }

    // Used by reads inside a group message subcollection, where `resource`
    // refers to the message rather than the parent group document.
    function groupMember(groupId) {
      return isAuth() && isActiveOwner(request.auth.uid) &&
        userDoc(request.auth.uid).data.get('role', '') == 'aluno' &&
        get(/databases/$(database)/documents/grupos/$(groupId)).data.get('membros', []) is list &&
        request.auth.uid in get(/databases/$(database)/documents/grupos/$(groupId)).data.membros;
    }

    // Global workout plan library.
    match /planosTreino/{planId} {
      allow read, write: if isAdmin();
    }

    match /questionnaireConfig/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Materialized, read-only dashboard counters maintained by a trusted
    // Firestore trigger. Clients must never write or reset these values.
    match /adminAggregates/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid);

      // Admins provision profiles. Students may only change client-owned
      // profile/preferences fields. Privacy consent and questionnaire
      // completion are written by their dedicated server-side flows.
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isActiveOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome', 'pesoAtual', 'altura', 'dataNascimento', 'fotoPerfil', 'genero',
          'notificationSound', 'soundEnabled', 'ultimaAtividade',
          'hasPendingProgress', 'progressRequestedAt'
        ])
      ) || (
        isActiveOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'questionnaireCompletedAt', 'questionnaireVersion', 'nome', 'genero',
          'pesoAtual', 'altura', 'dataNascimento'
        ]) &&
        request.resource.data.get('questionnaireVersion', '') ==
          activeQuestionnaireVersion() &&
        validQuestionnaireCompletion(uid)
      );

      match /adminData/{docId} {
        allow read, write: if isAdmin();
      }

      // O consentimento é escrito exclusivamente pela callable que cria o
      // evento de auditoria com timestamp de servidor.
      match /privacyConsentAudit/{docId} {
        allow read: if isAdmin() || isOwner(uid);
        allow write: if false;
      }

      match /questionario/{docId} {
        allow read: if isAdmin() || isOwner(uid);
        allow create, update: if isAdmin() || (
          isActiveOwner(uid) &&
          docId == 'resposta' &&
          validQuestionnaire(request.resource.data)
        );
        allow delete: if false;
      }

      match /diario/{date} {
        function validDiary(data) {
          return data.keys().hasOnly([
              'agua', 'passos', 'avaliacao', 'treinoConcluido',
              'refeicoes', 'treinoData'
            ]) &&
            data.get('agua', 0) is int && data.get('agua', 0) >= 0 &&
            data.get('agua', 0) <= 20000 &&
            data.get('passos', 0) is int && data.get('passos', 0) >= 0 &&
            data.get('passos', 0) <= 200000 &&
            data.get('avaliacao', 0) is int && data.get('avaliacao', 0) >= 0 &&
            data.get('avaliacao', 0) <= 5 &&
            data.get('treinoConcluido', false) is bool &&
            data.get('refeicoes', []) is list &&
            data.get('refeicoes', []).size() <= 30 &&
            (!data.keys().hasAny(['treinoData']) || data.treinoData is map);
        }
        allow read: if isAdmin() || isActiveOwner(uid);
        allow create, update: if isAdmin() ||
          (isActiveOwner(uid) && validDiary(request.resource.data));
        allow delete: if isAdmin();
      }

      match /planoNutricao/{diaSemana} {
        allow read: if isAdmin() || isActiveOwner(uid);
        allow write: if isAdmin();
      }

      match /planoTreino/{nome} {
        allow read: if isAdmin() || isActiveOwner(uid);
        allow write: if isAdmin();
      }

      match /workoutLogs/{date} {
        function validWorkoutLog(data) {
          return data.keys().hasOnly([
              'userId', 'data', 'planoSemana', 'diaSemana', 'subPlanoId',
              'foco', 'exercicios', 'completedAt', 'duracaoMinutos'
            ]) &&
            data.get('userId', '') == uid &&
            data.get('data', null) is timestamp &&
            data.get('data', request.time) <= request.time &&
            data.get('planoSemana', '') is string &&
            data.get('planoSemana', '').size() <= 200 &&
            data.get('diaSemana', '') is string &&
            data.get('diaSemana', '').size() <= 100 &&
            data.get('foco', '') is string && data.get('foco', '').size() <= 300 &&
            data.get('exercicios', []) is list && data.get('exercicios', []).size() <= 100 &&
            data.get('duracaoMinutos', 0) is int &&
            data.get('duracaoMinutos', 0) >= 0 && data.get('duracaoMinutos', 0) <= 1440 &&
            (!data.keys().hasAny(['completedAt']) || data.completedAt is timestamp);
        }
        allow read: if isAdmin() || isActiveOwner(uid);
        allow create, update: if isAdmin() ||
          (isActiveOwner(uid) && validWorkoutLog(request.resource.data));
        allow delete: if isAdmin();
      }

      match /progressVideos/{videoId} {
        allow read: if isAdmin() || isActiveOwner(uid);
        allow create: if isAdmin() || (
          isActiveOwner(uid) &&
          request.resource.data.keys().hasOnly([
            'userId', 'exerciseName', 'videoUrl', 'createdAt', 'uploadedBy',
            'status', 'feedback', 'reviewedAt'
          ]) &&
          request.resource.data.get('userId', uid) == uid &&
          request.resource.data.get('uploadedBy', '') == request.auth.uid &&
          request.resource.data.get('status', 'pending') == 'pending'
        );
        allow update: if isAdmin();
        allow delete: if false;
      }

      match /progresso/{docId} {
        function validProgress(data) {
          return data.keys().hasOnly([
              'userId', 'data', 'peso', 'medidas', 'fotos', 'fotosPorPosicao'
            ]) &&
            data.get('userId', '') == uid &&
            data.get('data', null) is timestamp &&
            data.get('data', request.time) <= request.time &&
            (!data.keys().hasAny(['peso']) ||
              (data.peso is number && data.peso >= 0 && data.peso <= 500)) &&
            data.get('medidas', {}) is map && data.medidas.keys().size() <= 30 &&
            data.get('fotos', []) is list && data.fotos.size() <= 10 &&
            (!data.keys().hasAny(['fotosPorPosicao']) || data.fotosPorPosicao is map);
        }
        allow read: if isAdmin() || isActiveOwner(uid);
        allow create, update: if isAdmin() ||
          (isActiveOwner(uid) && validProgress(request.resource.data));
        allow delete: if isAdmin();
      }
    }

    // Direct one-to-one chat. Every room must contain exactly the two
    // participants. A student is additionally tied to their assigned admin.
    match /chat/{salaId} {
      allow read: if isAdmin() || legacyDirectRoomForCurrentUser(salaId) ||
        directRoomMember(resource.data);
      allow create: if validDirectRoomForCurrentUser(request.resource.data) &&
        request.resource.data.keys().hasOnly([
          'participantIds', 'lastMessage', 'lastTimestamp', 'lastSenderId',
          'lastMessageId', 'typing', 'typingAt', 'lastReadAt'
        ]);
      // Admins can also migrate a legacy room once by adding the participant
      // list. After that list exists it is immutable for everyone.
      allow update: if (
          isAdmin() &&
          !resource.data.keys().hasAny(['participantIds']) &&
          validDirectParticipants(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'participantIds', 'lastMessage', 'lastTimestamp', 'lastSenderId',
            'lastMessageId', 'typing', 'typingAt', 'lastReadAt'
          ])
        ) || (
          !resource.data.keys().hasAny(['participantIds']) &&
          validDirectRoomForCurrentUser(request.resource.data) &&
          directRoomIdMatchesParticipants(salaId, request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'participantIds', 'lastMessage', 'lastTimestamp', 'lastSenderId',
            'lastMessageId', 'typing', 'typingAt'
          ]) && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'lastMessage', 'lastTimestamp', 'lastSenderId', 'lastMessageId'
            ]) || (
              request.resource.data.get('lastSenderId', '') == request.auth.uid &&
              request.resource.data.get('lastMessage', '') is string &&
              request.resource.data.get('lastMessage', '').size() <= 1000 &&
              request.resource.data.get('lastTimestamp', null) is timestamp &&
              request.resource.data.get('lastMessageId', '') is string
            )
          )
        ) || (
          isAdmin() &&
          validDirectParticipants(resource.data) &&
          request.resource.data.participantIds == resource.data.participantIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage', 'lastTimestamp', 'lastSenderId', 'lastMessageId',
            'typing', 'typingAt', 'lastReadAt'
          ])
        ) || (
          directRoomMember(resource.data) &&
          request.resource.data.participantIds == resource.data.participantIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage', 'lastTimestamp', 'lastSenderId', 'lastMessageId',
            'typing', 'typingAt'
          ]) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'lastMessage', 'lastTimestamp', 'lastSenderId', 'lastMessageId'
            ]) ||
            (
              request.resource.data.get('lastSenderId', '') == request.auth.uid &&
              request.resource.data.get('lastMessage', '') is string &&
              request.resource.data.get('lastMessage', '').size() <= 1000 &&
              request.resource.data.get('lastTimestamp', null) is timestamp &&
              request.resource.data.get('lastMessageId', '') is string
            )
          )
        );
      allow delete: if false;

      match /mensagens/{msgId} {
        allow read: if isAdmin() || legacyDirectRoomForCurrentUser(salaId) ||
          directRoomMember(
            get(/databases/$(database)/documents/chat/$(salaId)).data
          );
        allow create: if directRoomMemberAfter(salaId) &&
          validMessage(request.resource.data);
        allow update: if (
          isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida']) &&
          request.resource.data.get('lida', false) == true
        ) || (
          directRoomMember(
            get(/databases/$(database)/documents/chat/$(salaId)).data
          ) &&
          resource.data.get('remetenteId', '') != request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida']) &&
          request.resource.data.get('lida', false) == true
        );
        allow delete: if false;
      }
    }

    match /alimentos/{docId} {
      allow read: if isAdmin() || (
        isActiveOwner(request.auth.uid) &&
        userDoc(request.auth.uid).data.get('role', '') == 'aluno'
      );
      allow write: if isAdmin();
    }

    match /exercicios/{docId} {
      allow read: if isAdmin() || isActiveOwner(request.auth.uid);
      allow write: if isAdmin();
    }

    match /agenda/{docId} {
      allow read: if isAdmin() || (isActiveOwner(request.auth.uid) && (
        resource.data.studentId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        resource.data.trainerId == userDoc(request.auth.uid).data.get('personalId', '')
      ));
      // Student bookings are created by the transactional createBooking
      // callable. Direct client creates are intentionally denied.
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isActiveOwner(request.auth.uid) &&
        resource.data.studentId == request.auth.uid &&
        resource.data.trainerId == userDoc(request.auth.uid).data.get('personalId', '') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        resource.data.get('status', 'pending') in ['pending', 'confirmed'] &&
        request.resource.data.get('status', '') == 'cancelled'
      );
      allow delete: if isAdmin();
    }

    match /pagamentos/{docId} {
      allow read: if isAdmin() || (isOwner(request.auth.uid) &&
        resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /notificacoes/{docId} {
      allow read: if isAdmin() ||
        (isOwner(request.auth.uid) && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() ||
        (isOwner(request.auth.uid) &&
         resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']) &&
         request.resource.data.get('read', false) == true);
      allow create, delete: if isAdmin();
    }

    match /grupos/{groupId} {
      // Membership is checked directly on every returned group document.
      // The student query uses array-contains with the authenticated UID.
      allow read: if isAdmin() || (
        isActiveOwner(request.auth.uid) &&
        request.auth.uid in resource.data.membros
      );
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        groupMember(groupId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastReadAtByUser', 'lastMessage', 'lastTimestamp',
          'lastSenderId', 'lastMessageId'
        ]) &&
        request.resource.data.membros == resource.data.membros &&
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage', 'lastTimestamp', 'lastSenderId', 'lastMessageId'
          ]) &&
          request.resource.data.get('lastSenderId', '') == request.auth.uid &&
          request.resource.data.get('lastMessage', '') is string &&
          request.resource.data.get('lastMessage', '').size() <= 1000 &&
          request.resource.data.get('lastTimestamp', null) is timestamp
          ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAtByUser']) &&
          request.resource.data.get('lastReadAtByUser', {}) is map &&
          request.resource.data.get('lastReadAtByUser', {}).diff(
            resource.data.get('lastReadAtByUser', {})
          ).affectedKeys().hasOnly([request.auth.uid])
        )
      );
      allow delete: if isAdmin();

      match /mensagens/{msgId} {
        allow read: if isAdmin() || groupMember(groupId);
        allow create: if isAdmin() || (groupMember(groupId) &&
          validGroupMessage(request.resource.data));
        allow update, delete: if false;
      }
    }
  }
}
