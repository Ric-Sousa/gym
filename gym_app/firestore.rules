rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the user authenticated? ──────────
    function isAuth() {
      return request.auth != null;
    }

    // ── Helper: is the user an admin? ──────────────
    // Usa .get('role', '') para nunca falhar quando o campo não existe
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // ── Helper: does the user own this document? ───
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isActiveOwner(uid) {
      return isOwner(uid) &&
        get(/databases/$(database)/documents/users/$(uid)).data.get('isActive', true) == true &&
        (
          !get(/databases/$(database)/documents/users/$(uid)).data.keys().hasAny(['contractEndsAt']) ||
          get(/databases/$(database)/documents/users/$(uid)).data.get('contractEndsAt', null) == null ||
          get(/databases/$(database)/documents/users/$(uid)).data.get('contractEndsAt', request.time) > request.time
        );
    }

    // ══════════════════════════════════════════════════════
    // GLOBAL WORKOUT PLAN LIBRARY
    // ══════════════════════════════════════════════════════
    match /planosTreino/{planId} {
      allow read, write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════
    // USERS collection
    // ══════════════════════════════════════════════════════
    match /users/{uid} {

      // O próprio utilizador pode ler o estado do perfil para que o cliente
      // consiga mostrar a razão do bloqueio; apenas perfis ativos podem escrever.
      allow read: if isAdmin() || isOwner(uid);
      allow update: if isAdmin() || (
        isActiveOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome', 'pesoAtual', 'altura', 'fotoPerfil', 'genero',
          'notificationSound', 'soundEnabled', 'ultimaAtividade',
          'hasPendingProgress', 'progressRequestedAt', 'fcmToken',
          'privacyPolicyAcceptedAt', 'privacyPolicyVersion'
        ]) &&
        request.resource.data.get('privacyPolicyVersion', '') == 'privacy-2026-08-draft' &&
        request.resource.data.get('privacyPolicyAcceptedAt', request.time) <= request.time
      ) || (
        isActiveOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'questionnaireCompletedAt', 'questionnaireVersion', 'genero'
        ]) &&
        request.resource.data.get('questionnaireVersion', '') == 'questionnaire-2026-08-gender' &&
        request.resource.data.get('genero', '') in ['masculino', 'feminino'] &&
        request.resource.data.get('questionnaireCompletedAt', request.time) <= request.time
      );
      allow create: if isAdmin();

      // Notas internas nunca são visíveis ao aluno.
      match /adminData/{docId} {
        allow read, write: if isAdmin();
      }

      // ── INITIAL QUESTIONNAIRE ────────────────────
      // A ficha contém informação de saúde e só pode ser lida pelo aluno
      // ou por um administrador. O aluno só pode preencher a resposta fixa.
      match /questionario/{docId} {
        allow read: if isAdmin() || isOwner(uid);
        allow create, update: if isAdmin() || (
          isActiveOwner(uid) &&
          docId == 'resposta' &&
          request.resource.data.get('version', '') == 'questionnaire-2026-08-gender' &&
          request.resource.data.keys().hasOnly([
            'version', 'completedAt', 'answers'
          ]) &&
          request.resource.data.get('answers', {}).keys().hasOnly([
            'birthDate', 'genero', 'profession', 'activity', 'sedentary', 'meals',
            'water', 'sleep', 'pathologies', 'familyPathologies', 'surgery',
            'medication', 'allergies', 'dislikedFoods', 'preferredFoods',
            'outsideMeals', 'objective'
          ])
        );
        allow delete: if false;
      }

      // ── DIARY subcollection ──────────────────────
      match /diario/{date} {
        allow read, write: if isAdmin() || isActiveOwner(uid);
      }

      // ── NUTRITION PLAN subcollection ─────────────
      match /planoNutricao/{diaSemana} {
        allow read: if isAdmin() || isActiveOwner(uid);
        allow write: if isAdmin(); // only admin writes nutrition plans
      }

      // ── WORKOUT PLAN subcollection ───────────────
      match /planoTreino/{nome} {
        allow read: if isAdmin() || isActiveOwner(uid);
        allow write: if isAdmin(); // only admin writes workout plans
      }

      // ── WORKOUT LOGS subcollection ─────────────────
      match /workoutLogs/{date} {
        allow read, write: if isAdmin() || isActiveOwner(uid);
      }

      // ── PROGRESS VIDEOS subcollection ────────────
      match /progressVideos/{videoId} {
        allow read: if isAdmin() || isActiveOwner(uid);
        // O aluno só pode criar um vídeo pendente para a própria conta.
        // O admin pode criar vídeos para qualquer aluno, mas a aprovação é
        // sempre controlada pelo admin no update.
        allow create: if isAdmin() || (
          isActiveOwner(uid) &&
          request.resource.data.get('userId', uid) == uid &&
          request.resource.data.get('uploadedBy', '') == request.auth.uid &&
          request.resource.data.get('status', 'pending') == 'pending'
        );
        // O aluno pode editar apenas os dados do seu próprio upload, sem
        // alterar aprovação, feedback ou autoria. O admin revê o vídeo.
        allow update: if isAdmin();
      }

      // ── PROGRESS subcollection ───────────────────
      match /progresso/{docId} {
        allow read: if isAdmin() || isActiveOwner(uid);
        allow create: if isActiveOwner(uid); // user can create progress entries
        allow update: if isAdmin() || isActiveOwner(uid);
      }
    }

    // ══════════════════════════════════════════════════════
    // CHAT collection
    // ══════════════════════════════════════════════════════
    match /chat/{salaId} {
      // Qualquer utilizador autenticado pode ler, criar e atualizar salas de chat
      allow read, create, update: if isAdmin() || isActiveOwner(request.auth.uid);
      // Ninguém pode apagar salas de chat ou mensagens (persistência garantida)
      allow delete: if false;

      match /mensagens/{msgId} {
        allow read, create: if isAdmin() || isActiveOwner(request.auth.uid);
        // Apenas o admin marca mensagens como lidas. O get() permite adicionar
        // lida a mensagens antigas que ainda não possuíam esse campo.
        allow update: if isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lida']) &&
          request.resource.data.get('lida', false) == true;
        // Mensagens não podem ser apagadas.
        allow delete: if false;
      }
    }

    // ══════════════════════════════════════════════════════
    // FOODS collection (global, admin-only write)
    // ══════════════════════════════════════════════════════
    match /alimentos/{docId} {
      allow read: if isAdmin() || isActiveOwner(request.auth.uid);
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════
    // EXERCISES collection (global, admin-only write)
    // ══════════════════════════════════════════════════════
    match /exercicios/{docId} {
      allow read: if isAdmin() || isActiveOwner(request.auth.uid);
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════
    // AGENDA collection (bookings)
    // ══════════════════════════════════════════════════════
    match /agenda/{docId} {
      // Aluno vê as suas próprias marcações, as do seu trainer (conflitos),
      // e o trainer vê as dele pelo próprio UID.
      // Admin vê todas.
      // Usa .get('field', '') para nunca falhar com campos em falta.
      allow read: if isAdmin() || (isActiveOwner(request.auth.uid) && (
        resource.data.studentId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        resource.data.trainerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('personalId', '')
      ));
      // Aluno pode criar marcações (status='pending'); admin pode criar/atualizar qualquer
      allow create: if isAdmin() || (isActiveOwner(request.auth.uid) &&
        request.resource.data.studentId == request.auth.uid
      );
      // Admin, o próprio aluno OU o trainer pode atualizar (ex: cancelar, concluir)
      allow update: if isAdmin() || (isActiveOwner(request.auth.uid) && (
        resource.data.studentId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid
      ));
      // Só admin pode apagar
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════
    // PAYMENTS collection
    // ══════════════════════════════════════════════════════
    match /pagamentos/{docId} {
      // Aluno vê os seus próprios pagamentos; admin vê todos
      // O aluno pode consultar e pagar faturas pendentes mesmo depois de o
      // contrato expirar; o pagamento é o mecanismo para recuperar o acesso.
      allow read: if isAdmin() || (isOwner(request.auth.uid) &&
        resource.data.userId == request.auth.uid
      );
      // Só admin pode criar/atualizar pagamentos
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════
    // PERSISTENT NOTIFICATIONS
    // ══════════════════════════════════════════════════════
    match /notificacoes/{docId} {
      allow read: if isAdmin() ||
        (isOwner(request.auth.uid) && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() ||
        (isOwner(request.auth.uid) &&
         resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['read', 'readAt']) &&
         request.resource.data.get('read', false) == true);
      allow create, delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════
    // GROUPS collection
    // ══════════════════════════════════════════════════════
    match /grupos/{groupId} {
      // Qualquer utilizador autenticado pode ler grupos onde é membro
      allow read: if isAdmin() || (isActiveOwner(request.auth.uid) &&
        request.auth.uid in resource.data.membros
      );
      // Admin pode criar/atualizar grupos
      allow create, update: if isAdmin() || (isActiveOwner(request.auth.uid) &&
        request.auth.uid in request.resource.data.membros
      );
      allow delete: if isAdmin();

      // ── GROUP MESSAGES subcollection ─────────
      match /mensagens/{msgId} {
        allow read: if isAdmin() || (isActiveOwner(request.auth.uid) &&
          request.auth.uid in get(/databases/$(database)/documents/grupos/$(groupId)).data.membros
        );
        allow create: if isAdmin() || (isActiveOwner(request.auth.uid) &&
          request.auth.uid in get(/databases/$(database)/documents/grupos/$(groupId)).data.membros
        );
        allow update, delete: if false; // mensagens imutáveis
      }
    }

  }
}
