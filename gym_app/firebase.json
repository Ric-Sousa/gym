{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "gymbt-4ef87",
          "configurations": {
            "android": "1:844686321044:android:257856a3610576c63f9b81",
            "ios": "1:844686321044:ios:85d71d1fe64ae0f23f9b81",
            "web": "1:844686321044:web:fbedc9ce24285d303f9b81"
          }
        }
      }
    }
